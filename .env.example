# Configuration de la base de données SQLite locale
DATABASE_URL="file:./data/mosquee.db"

# Clé secrète de session pour l'authentification (à changer impérativement en production)
SESSION_SECRET="change-this-to-a-random-secret-key-at-least-32-chars-long"

# Configuration SMTP (optionnelle - désactivée par défaut tant qu'aucun e-mail n'est fourni)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
CONTACT_EMAIL_RECIPIENT=""

# Environnement (development / production)
NODE_ENV="development"
